{
    "name": "exercise/payments",
    "description": "Ticket Tailor organiser payments dashboard technical exercise",
    "license": "proprietary",
    "type": "project",
    "require": {
        "php": "~8.4.0",
        "laminas/laminas-config-aggregator": "^1.18",
        "laminas/laminas-diactoros": "^3.6",
        "laminas/laminas-servicemanager": "^4.5",
        "mezzio/mezzio": "^3.27",
        "mezzio/mezzio-fastroute": "^3.13",
        "monolog/monolog": "^3.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "autoload": {
        "psr-4": {
            "Payments\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Payments\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.4.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "check": [
            "phpunit",
            "phpstan analyse --memory-limit=256M --debug",
            "phpcs"
        ]
    }
}
